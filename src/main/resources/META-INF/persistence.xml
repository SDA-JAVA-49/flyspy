<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <persistence-unit name="flyspy-pu">
        <description>
            Persistence unit for the Course App
        </description>
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>al.sda.flyspy.domain.airline.model.entity.Airline</class>
        <class>al.sda.flyspy.domain.airport.model.entity.Airport</class>
        <class>al.sda.flyspy.domain.flight.model.entity.Flight</class>

        <properties>
            <!-- Database connection settings -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:33066/flyspy" />
            <property name="jakarta.persistence.jdbc.user" value="root" />
            <property name="jakarta.persistence.jdbc.password" value="Darondiora2003" />
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.highlight_sql" value="true" />
            <property name="hibernate.hbm2ddl.auto" value="update" />
        </properties>

    </persistence-unit>

</persistence>
